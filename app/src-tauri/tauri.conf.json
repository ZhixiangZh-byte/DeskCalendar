{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskCalendar",
  "version": "1.0.0",
  "identifier": "com.deskcalendar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://www.googleapis.com https://tasks.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ZhixiangZh-byte",
    "copyright": "Copyright © 2026 ZhixiangZh-byte",
    "category": "Productivity",
    "shortDescription": "DeskCalendar：Windows 桌面日历组件（Google Calendar / Tasks）",
    "longDescription": "贴在 Windows 桌面上的透明组件：月历、日视图、四象限、回顾箱、长期规划，直接读写 Google Calendar 和 Google Tasks。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "DeskCalendar"
      }
    }
  },
  "mainBinaryName": "DeskCalendar"
}
