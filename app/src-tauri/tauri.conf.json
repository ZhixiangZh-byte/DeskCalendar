{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskCalendar",
  "version": "0.1.0",
  "identifier": "com.deskcalendar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "month",
        "title": "DeskCalendar 月历",
        "width": 560,
        "height": 480,
        "minWidth": 380,
        "minHeight": 340,
        "x": 60,
        "y": 80,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://www.googleapis.com https://tasks.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "DeskCalendar"
}
