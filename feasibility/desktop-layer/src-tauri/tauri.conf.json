{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-layer",
  "version": "0.1.0",
  "identifier": "com.deskcalendar.layerproto",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "title": "DeskCalendar 桌面层原型",
        "width": 340,
        "height": 300,
        "x": 80,
        "y": 120,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
